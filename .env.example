# AssistantMD deployment settings
#
# Copy this file to .env. Keep .env private and backed up: it contains the key
# required to restore encrypted credentials. Most installations only need to
# set the encryption key, timezone, data path, and authentication mode.

# -----------------------------------------------------------------------------
# Persistent data (required)
# -----------------------------------------------------------------------------

# Required for encrypted secret storage. Generate a real value with the command
# in docs/setup/installation.md. Never reuse this value as an auth secret.
ASSISTANTMD_SECRETS_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY

# Host folder containing vault directories. Relative paths resolve from the
# folder containing docker-compose.yml. Pre-create it with suitable ownership.
ASSISTANTMD_DATA_PATH=./data

# Host folder for AssistantMD databases and other persistent system state.
ASSISTANTMD_SYSTEM_PATH=./system

# -----------------------------------------------------------------------------
# Basic deployment
# -----------------------------------------------------------------------------

TZ=UTC

# Host interface and port published by Docker Compose. Keep the default
# loopback address unless a deliberate network design requires otherwise.
ASSISTANTMD_BIND_ADDRESS=127.0.0.1
ASSISTANTMD_PORT=8000

# Pin both published images to one release tag. `latest` follows the current
# stable release.
ASSISTANTMD_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Application access
# -----------------------------------------------------------------------------

# disabled: no application authentication (safe only behind a trusted boundary)
# owner_token: built-in owner login; requires ASSISTANTMD_AUTH_SECRET
# trusted_proxy: proxy assertion; requires ASSISTANTMD_AUTH_SECRET
ASSISTANTMD_AUTH_MODE=disabled

# Generate a value with `openssl rand -hex 32`. Required by owner_token and
# trusted_proxy. Do not reuse ASSISTANTMD_SECRETS_KEY.
# ASSISTANTMD_AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET

# Browser-visible HTTPS origin for reverse proxies and external callbacks.
# Required for a supported remote deployment; do not include a trailing path.
# ASSISTANTMD_PUBLIC_URL=https://assistant.example.com

# -----------------------------------------------------------------------------
# Advanced shell (optional)
# -----------------------------------------------------------------------------

# Advanced mode requires both the Compose profile and application authorization.
# COMPOSE_PROFILES=advanced
# ASSISTANTMD_EXECUTION_MODE=advanced

# Defaults match the supplied advanced-shell service. Change these only when an
# override or external deployment changes the corresponding SSH coordinates.
# ASSISTANTMD_SHELL_HOST=advanced-shell
# ASSISTANTMD_SHELL_PORT=2222
# ASSISTANTMD_SHELL_USER=advanced-shell
