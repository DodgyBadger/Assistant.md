#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
VENV_PYTHON="${REPO_ROOT}/.venv/bin/python"
RUNTIME_ROOT="${ASSISTANTMD_DEV_RUNTIME_ROOT:-${REPO_ROOT}}"
DATA_ROOT="${CONTAINER_DATA_ROOT:-${RUNTIME_ROOT}/data}"
SYSTEM_ROOT="${CONTAINER_SYSTEM_ROOT:-${RUNTIME_ROOT}/system}"
DEV_AUTH_SECRET="assistantmd-development-auth-secret-not-for-production"

usage() {
  cat <<'EOF'
Usage: scripts/dev <command> [options]

Commands:
  setup [--browser]    Create or repair .venv, install dependencies, and build CSS
  run [options]        Start the development server with checkout-local state
  check                Run Ruff, Black, and MyPy
  scenario <selector>  Run one validation scenario selector
  doctor               Diagnose required tools and the checkout environment
  help                 Show this help

Run options:
  -p, --port <port>       Listen on this port (default: 8000)
  -a, --address <address> Override the authentication mode's listen address
      --auth-mode <mode>  Authentication: loopback, disabled, owner_token, or trusted_proxy
  -h, --help              Show run-specific help
  --                       Pass remaining arguments to Uvicorn

Environment:
  ASSISTANTMD_DEV_RUNTIME_ROOT  Use an alternate parent for data/ and system/
  CONTAINER_DATA_ROOT          Override the development vault root
  CONTAINER_SYSTEM_ROOT        Override the development system-state root
  ASSISTANTMD_DEV_HOST         Override the authentication mode's listen address
  ASSISTANTMD_DEV_PORT         Development server port (default: 8000)
  ASSISTANTMD_AUTH_MODE        Default mode when --auth-mode is omitted
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

require_command() {
  local command_name="$1"
  local install_hint="$2"
  command -v "${command_name}" >/dev/null 2>&1 || die "${command_name} is required. ${install_hint}"
}

require_node_22() {
  local node_major
  node_major="$(node -p 'process.versions.node.split(".")[0]')"
  [ "${node_major}" = "22" ] || die "Node.js 22 is required; found $(node --version)."
}

validate_port() {
  local port="$1"
  if ! [[ "${port}" =~ ^[0-9]+$ ]] || [ "${port}" -lt 1 ] || [ "${port}" -gt 65535 ]; then
    die "Port must be an integer between 1 and 65535; received '${port}'."
  fi
}

ensure_runtime_roots() {
  mkdir -p "${DATA_ROOT}" "${SYSTEM_ROOT}"
}

has_configured_secrets_key() {
  [ -x "${VENV_PYTHON}" ] || return 1
  REPO_ROOT="${REPO_ROOT}" "${VENV_PYTHON}" - <<'PY' >/dev/null 2>&1
import os
from pathlib import Path

from dotenv import dotenv_values

from core.secrets.crypto import SecretKeyring

env_path = Path(os.environ["REPO_ROOT"]) / ".env"
if env_path.exists():
    for name, value in dotenv_values(env_path).items():
        if value is not None:
            os.environ.setdefault(name, value)

try:
    SecretKeyring.from_environment()
except (RuntimeError, ValueError):
    raise SystemExit(1)
PY
}

public_url_status() {
  REPO_ROOT="${REPO_ROOT}" "${VENV_PYTHON}" - <<'PY'
import os
from pathlib import Path

from dotenv import dotenv_values

from core.runtime.public_url import PublicOrigin, PublicUrlError

env_path = Path(os.environ["REPO_ROOT"]) / ".env"
if env_path.exists():
    for name, value in dotenv_values(env_path).items():
        if value is not None:
            os.environ.setdefault(name, value)

raw = os.environ.get("ASSISTANTMD_PUBLIC_URL", "").strip()
if not raw:
    print("UNCONFIGURED")
else:
    try:
        print(f"CONFIGURED:{PublicOrigin.parse(raw).value}")
    except PublicUrlError:
        print("INVALID")
PY
}

print_secrets_key_guidance() {
  if has_configured_secrets_key; then
    echo "OK: encrypted secrets key configuration found."
    echo "Existing system/secrets.yaml values, if any, will migrate on the next application startup."
    return
  fi

  cat <<'EOF'

ACTION REQUIRED: configure the encrypted secrets key before starting AssistantMD.
Without it, the UI remains available for diagnostics, but providers, models,
MCP configuration, and secret mutation stay locked.

Generate a key with:

  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='

Copy the generated value into .env as:

  ASSISTANTMD_SECRETS_KEY=PASTE_GENERATED_KEY_HERE

Back up .env separately if you need to retain access to encrypted credentials.
Existing system/secrets.yaml values migrate on application startup after a
valid key is available.
EOF
}

require_environment() {
  if [ ! -x "${VENV_PYTHON}" ]; then
    die "The checkout environment is missing or broken. Run scripts/dev setup."
  fi
  if ! "${VENV_PYTHON}" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 13))'; then
    die "The checkout environment is not using Python 3.13. Run scripts/dev setup."
  fi
}

setup_environment() {
  local with_browser=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --browser)
        with_browser=true
        ;;
      *)
        die "Unknown setup option: $1"
        ;;
    esac
    shift
  done

  require_command uv "Install it from https://docs.astral.sh/uv/getting-started/installation/."
  require_command node "Install Node.js 22 before running the full application setup."
  require_command npm "Install npm with Node.js 22 before running the full application setup."
  require_node_22

  cd "${REPO_ROOT}"
  echo "Ensuring UV-managed Python 3.13 is available..."
  uv python install 3.13

  echo "Creating or repairing the checkout-local Python environment..."
  UV_LINK_MODE=copy uv sync \
    --python 3.13 \
    --frozen \
    --all-extras \
    --no-install-project

  echo "Installing frontend dependencies from package-lock.json..."
  npm ci --include=dev

  echo "Building static CSS..."
  npm run build:css

  ensure_runtime_roots

  if [ "${with_browser}" = true ]; then
    echo "Installing Playwright Chromium and required host libraries..."
    uv run python -m playwright install --with-deps chromium
  fi

  "${VENV_PYTHON}" -c 'import logfire, sys; assert sys.version_info[:2] == (3, 13)'
  echo "Development environment is ready."
  echo "Python: $("${VENV_PYTHON}" -V 2>&1)"
  echo "Runtime data: ${DATA_ROOT}"
  echo "Runtime system: ${SYSTEM_ROOT}"
  print_secrets_key_guidance
  echo "Start AssistantMD with: scripts/dev run"
}

run_server() {
  local address="${ASSISTANTMD_DEV_HOST:-}"
  local address_option_set=false
  local port="${ASSISTANTMD_DEV_PORT:-8000}"
  local auth_mode="${ASSISTANTMD_AUTH_MODE:-}"
  local auth_mode_option_set=false
  local -a uvicorn_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -p|--port)
        [ "$#" -ge 2 ] || die "$1 requires a port number."
        port="$2"
        shift 2
        ;;
      -a|--address)
        [ "$#" -ge 2 ] || die "$1 requires an address."
        [ "${address_option_set}" = false ] || die "Specify --address only once."
        [ -n "$2" ] || die "$1 requires a non-empty address."
        address="$2"
        address_option_set=true
        shift 2
        ;;
      --auth-mode)
        [ "$#" -ge 2 ] || die "$1 requires an authentication mode."
        [ "${auth_mode_option_set}" = false ] || die "Specify --auth-mode only once."
        auth_mode="$2"
        auth_mode_option_set=true
        shift 2
        ;;
      -h|--help)
        usage
        return
        ;;
      --)
        shift
        uvicorn_args=("$@")
        break
        ;;
      *)
        die "Unknown run option: $1. Put advanced Uvicorn arguments after --."
        ;;
    esac
  done

  validate_port "${port}"
  require_command uv "Install it from https://docs.astral.sh/uv/getting-started/installation/."
  require_environment
  ensure_runtime_roots
  cd "${REPO_ROOT}"
  export CONTAINER_DATA_ROOT="${DATA_ROOT}"
  export CONTAINER_SYSTEM_ROOT="${SYSTEM_ROOT}"
  if [ -z "${auth_mode}" ]; then
    address="${address:-127.0.0.1}"
    case "${address}" in
      127.0.0.1|::1|localhost)
        auth_mode="loopback"
        ;;
      *)
        die "Use --auth-mode when development is not bound to loopback."
        ;;
    esac
  elif [ -z "${address}" ]; then
    case "${auth_mode}" in
      loopback)
        address="127.0.0.1"
        ;;
      disabled|owner_token|trusted_proxy)
        address="0.0.0.0"
        ;;
    esac
  fi
  case "${auth_mode}" in
    disabled|loopback)
      if [ "${auth_mode_option_set}" = true ]; then
        unset ASSISTANTMD_AUTH_SECRET ASSISTANTMD_AUTH_SECRET_FILE
        unset ASSISTANTMD_AUTH_TRUSTED_PROXY_NETWORKS
      fi
      ;;
    owner_token)
      case "${address}" in
        127.0.0.1|::1|localhost) ;;
        *)
          echo "WARNING: The fixed development owner token is publicly known and does not protect a reachable server." >&2
          ;;
      esac
      export ASSISTANTMD_AUTH_SECRET="${DEV_AUTH_SECRET}"
      unset ASSISTANTMD_AUTH_SECRET_FILE ASSISTANTMD_AUTH_TRUSTED_PROXY_NETWORKS
      ;;
    trusted_proxy)
      if [ "${auth_mode_option_set}" = true ]; then
        export ASSISTANTMD_AUTH_SECRET="${DEV_AUTH_SECRET}"
        unset ASSISTANTMD_AUTH_SECRET_FILE ASSISTANTMD_AUTH_TRUSTED_PROXY_NETWORKS
      else
        [ -n "${ASSISTANTMD_AUTH_SECRET:-}" ] || [ -n "${ASSISTANTMD_AUTH_SECRET_FILE:-}" ] || \
          die "trusted_proxy mode requires ASSISTANTMD_AUTH_SECRET or ASSISTANTMD_AUTH_SECRET_FILE."
      fi
      ;;
    *)
      die "Unsupported authentication mode '${auth_mode}'."
      ;;
  esac
  export ASSISTANTMD_AUTH_MODE="${auth_mode}"
  echo "Authentication mode: ${auth_mode}"
  if [ "${auth_mode}" = "owner_token" ]; then
    echo "Development owner token: ${DEV_AUTH_SECRET}"
  elif [ "${auth_mode}" = "trusted_proxy" ] && [ "${auth_mode_option_set}" = true ]; then
    echo "Development proxy assertion: ${DEV_AUTH_SECRET}"
  fi
  local -a env_file_args=()
  if [ -f "${REPO_ROOT}/.env" ]; then
    env_file_args=(--env-file "${REPO_ROOT}/.env")
  fi
  exec uv run uvicorn main:app \
    --host "${address}" \
    --port "${port}" \
    --reload \
    "${env_file_args[@]}" \
    "${uvicorn_args[@]}"
}

run_checks() {
  require_command uv "Install it from https://docs.astral.sh/uv/getting-started/installation/."
  require_environment
  cd "${REPO_ROOT}"
  uv run ruff check .
  uv run black --check .
  uv run mypy api core
}

run_scenarios() {
  [ "$#" -eq 1 ] || die "Provide exactly one scenario selector."
  require_command uv "Install it from https://docs.astral.sh/uv/getting-started/installation/."
  require_environment
  cd "${REPO_ROOT}"
  uv run python validation/run_validation.py run "$@"
}

doctor() {
  local browser_path
  local public_url_result
  local failures=0
  cd "${REPO_ROOT}"
  echo "Repository: ${REPO_ROOT}"

  for command_name in git uv node npm curl rg cc; do
    if command -v "${command_name}" >/dev/null 2>&1; then
      echo "OK: ${command_name} -> $(command -v "${command_name}")"
    else
      echo "MISSING: ${command_name}"
      failures=$((failures + 1))
    fi
  done

  if command -v node >/dev/null 2>&1; then
    if [ "$(node -p 'process.versions.node.split(".")[0]')" = "22" ]; then
      echo "OK: $(node --version)"
    else
      echo "BROKEN: Node.js 22 is required; found $(node --version)"
      failures=$((failures + 1))
    fi
  fi

  if [ -x "${VENV_PYTHON}" ]; then
    echo "OK: venv python -> ${VENV_PYTHON}"
    if "${VENV_PYTHON}" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 13))'; then
      echo "OK: $("${VENV_PYTHON}" -V 2>&1)"
    else
      echo "BROKEN: .venv does not use Python 3.13"
      failures=$((failures + 1))
    fi
    if "${VENV_PYTHON}" -c 'import logfire' >/dev/null 2>&1; then
      echo "OK: logfire import"
    else
      echo "BROKEN: logfire is not importable from .venv"
      failures=$((failures + 1))
    fi
    if browser_path="$("${VENV_PYTHON}" - <<'PY'
from pathlib import Path

from playwright.sync_api import sync_playwright

with sync_playwright() as playwright:
    path = Path(playwright.chromium.executable_path)
    print(path if path.exists() else "")
PY
)"; then
      if [ -n "${browser_path}" ]; then
        echo "OK: Playwright Chromium -> ${browser_path}"
      else
        echo "OPTIONAL: Playwright Chromium is not installed; run scripts/dev setup --browser when needed"
      fi
    else
      echo "BROKEN: playwright is not usable from .venv"
      failures=$((failures + 1))
    fi
  else
    echo "BROKEN: ${VENV_PYTHON} is missing or not executable"
    failures=$((failures + 1))
  fi

  echo "Runtime data: ${DATA_ROOT}"
  echo "Runtime system: ${SYSTEM_ROOT}"

  if has_configured_secrets_key; then
    echo "OK: encrypted secrets key configuration found"
  else
    echo "MISSING: encrypted secrets key configuration; providers, models, MCP configuration, and secret mutation will be locked"
    failures=$((failures + 1))
    print_secrets_key_guidance
  fi

  public_url_result="$(public_url_status)"
  case "${public_url_result}" in
    CONFIGURED:*)
      echo "OK: canonical public URL -> ${public_url_result#CONFIGURED:}"
      ;;
    UNCONFIGURED)
      echo "OPTIONAL: ASSISTANTMD_PUBLIC_URL is not configured; browser callback origins will be inferred"
      ;;
    *)
      echo "BROKEN: ASSISTANTMD_PUBLIC_URL is invalid"
      failures=$((failures + 1))
      ;;
  esac

  if [ "${failures}" -ne 0 ]; then
    echo "Doctor found ${failures} blocking issue(s). Resolve the missing items reported above; scripts/dev setup repairs the development environment but does not generate encryption keys." >&2
    return 1
  fi
  echo "Development environment checks passed."
}

command_name="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "${command_name}" in
  setup)
    setup_environment "$@"
    ;;
  run)
    run_server "$@"
    ;;
  check)
    [ "$#" -eq 0 ] || die "The check command does not accept arguments."
    run_checks
    ;;
  scenario)
    run_scenarios "$@"
    ;;
  doctor)
    [ "$#" -eq 0 ] || die "The doctor command does not accept arguments."
    doctor
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    die "Unknown command: ${command_name}"
    ;;
esac
