      "id": "research_memo_corrections",
      "description": "A research memo accumulates constraints, changes citation style, creates an artifact, and resolves a blocker.",
      "phenomena": [
        "goal",
        "correction",
        "constraint",
        "commitment",
        "tool_observation",
        "artifact",
        "open_question",
        "resolved_blocker"
      ],
      "messages": [
        {"sequence_index": 0, "kind": "user", "content": "Prepare the Northstar client research memo."},
        {"sequence_index": 1, "kind": "assistant", "content": "I created an outline and will collect source notes next."},
        {"sequence_index": 2, "kind": "user", "content": "Keep it under 1,200 words and cite sources in APA style."},
        {"sequence_index": 3, "kind": "assistant", "content": "I will preserve the word limit and APA citation requirement."},
        {"sequence_index": 4, "kind": "user", "content": "Correction: use Chicago notes, not APA."},
        {"sequence_index": 5, "kind": "assistant", "content": "Understood. Chicago notes supersedes APA."},
        {"sequence_index": 6, "kind": "assistant_tool_call", "tool_name": "write_file", "tool_call_id": "northstar-notes", "content": "Write source notes to Research/northstar-notes.md"},
        {"sequence_index": 7, "kind": "tool", "tool_name": "write_file", "tool_call_id": "northstar-notes", "content": "Created Research/northstar-notes.md with six cited sources."},
        {"sequence_index": 8, "kind": "assistant", "content": "The source-notes artifact is complete; the next step is drafting the synthesis."},
        {"sequence_index": 9, "kind": "user", "content": "The audience is the board. The finance appendix is still unavailable."},
        {"sequence_index": 10, "kind": "assistant", "content": "The synthesis is drafted for the board, but the missing finance appendix blocks final review."},
        {"sequence_index": 11, "kind": "user", "content": "Proceed without the appendix and mark that limitation explicitly."},
        {"sequence_index": 12, "kind": "assistant", "content": "The memo draft is complete with the finance limitation noted. Next action: perform final editorial review."}
