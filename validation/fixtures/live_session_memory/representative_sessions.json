    {
      "id": "read_only_migration_diagnosis",
      "description": "A read-only diagnosis includes a failed tool attempt, an explicit retry boundary, and a source-supported conclusion.",
      "phenomena": [
        "goal",
        "constraint",
        "tool_observation",
        "failed_turn",
        "open_question",
        "artifact",
        "decision"
      ],
      "messages": [
        {"sequence_index": 0, "kind": "user", "content": "Diagnose why the settings migration fails on startup."},
        {"sequence_index": 1, "kind": "assistant", "content": "I will inspect configuration and migration evidence before proposing a cause."},
        {"sequence_index": 2, "kind": "assistant_tool_call", "tool_name": "read_file", "tool_call_id": "read-settings", "content": "Read system/settings.yaml"},
        {"sequence_index": 3, "kind": "tool", "tool_name": "read_file", "tool_call_id": "read-settings", "content": "settings.yaml contains schema_version: 4 and provider legacy_host."},
        {"sequence_index": 4, "kind": "assistant", "content": "The legacy_host provider is a candidate cause; migration execution still needs verification."},
        {"sequence_index": 5, "kind": "user", "content": "Do not modify any files. Diagnosis only."},
        {"sequence_index": 6, "kind": "assistant", "content": "I will remain read-only and run the isolated migration fixture."},
        {"sequence_index": 7, "kind": "user", "content": "Use the checked-in fixture instead of the unavailable production snapshot."},
        {"sequence_index": 8, "kind": "assistant_tool_call", "tool_name": "run_validation", "tool_call_id": "migration-fixture", "content": "Run the isolated settings migration fixture"},
        {"sequence_index": 9, "kind": "tool", "tool_name": "run_validation", "tool_call_id": "migration-fixture", "content": "Fixture failed at provider normalization: legacy_host has no base_url."},
        {"sequence_index": 10, "kind": "assistant", "content": "Root cause confirmed: legacy_host lacks the required base_url. I recorded the diagnosis in Reports/settings-migration-diagnosis.md without modifying settings."}
      ],
      "failed_attempts": [
        {"after_sequence_index": 6, "phase": "tool_execution", "failure_kind": "source_unavailable", "committed": false, "detail": "The production snapshot was unavailable."}
      ],
      "classifier_batches": [
        {"from_sequence_index": 0, "through_sequence_index": 4, "changed_dimensions": ["attention", "goals", "work_items", "commitments", "observations"]},
        {"from_sequence_index": 5, "through_sequence_index": 7, "changed_dimensions": ["work_items", "constraints", "commitments", "open_questions"]},
        {"from_sequence_index": 8, "through_sequence_index": 10, "changed_dimensions": ["work_items", "decisions", "open_questions", "artifacts", "observations"]}
      ],
      "compaction_checkpoints": [
        {
          "after_sequence_index": 4,
          "expected_recovery_card": {
            "required_concepts": ["diagnose startup migration", "legacy_host candidate", "verify migration execution"],
            "forbidden_concepts": ["root cause confirmed", "modify settings"]
          }
        },
        {
          "after_sequence_index": 7,
          "expected_recovery_card": {
            "required_concepts": ["read-only diagnosis", "checked-in fixture", "production snapshot unavailable"],
            "forbidden_concepts": ["root cause confirmed", "settings were changed"]
          }
        },
        {
          "after_sequence_index": 10,
          "expected_recovery_card": {
            "required_concepts": ["legacy_host lacks base_url", "diagnosis recorded", "no settings modification"],
            "forbidden_concepts": ["production snapshot required", "apply the migration fix"]
          }
        }
      ],
