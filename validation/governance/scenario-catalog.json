{
  "schema_version": 1,
  "contracts": [
    {
      "id": "ingress.owner_and_csrf_boundaries",
      "requirement": "In owner-token mode, protected access requires valid owner authentication and owner-cookie mutations require valid session-bound CSRF proof.",
      "proof_surface": "Real production ASGI application/runtime responses for owner authentication, cookie-bound mutation admission and authentication activity; browser, live TCP/TLS and deployment topology are outside this pilot.",
      "review_reference": "pilot-ingress-review.json: discriminating execution evidence recorded; external maintainer acceptance remains pending.",
      "review_evidence": [
        "pilot-ingress-review.json"
      ]
    },
    {
      "id": "settings.reset.preserves_newer_edit",
      "requirement": "A domain settings reset fenced to a backup revision rejects a conflicting newer edit and preserves that edit.",
      "proof_surface": "Actual repository backup/domain reset operations, persisted SQLite revision and settings snapshots, plus API reads; API backup-to-reset race scheduling remains outside this pilot.",
      "review_reference": "pilot-settings-review.json: discriminating execution evidence recorded; external maintainer acceptance remains pending.",
      "review_evidence": [
        "pilot-settings-review.json"
      ]
    },
    {
      "id": "framework.execution.preserves_failure_accounting",
      "requirement": "Combined execution and cleanup/evidence failures retain the primary error; the lifecycle pilot reports crashes and hard deadlines as non-passing and records the unstarted second selection after interruption of a two-scenario batch.",
      "proof_surface": "Fourteen real CLI worker fixture modes inspect primary/secondary results, lifecycle/supervisor artifacts and exit statuses; interruption accounting is demonstrated with a two-scenario selection, not arbitrary selector permutations.",
      "review_reference": "pilot-runner-review.json: discriminating execution evidence recorded; external maintainer acceptance remains pending.",
      "review_evidence": [
        "pilot-runner-review.json"
      ]
    },
    {
      "id": "framework.governance.requires_current_manual_approval",
      "requirement": "The governance CI helper requires the expected audit and approval outcomes and the current PR head and base before posting success, while validating the configured reviewer, environment and branch policy.",
      "proof_surface": "Actual governance CI helper decisions using real Git trees and a loopback GitHub protocol fixture; native GitHub approval enforcement and PR-specific commit-status invalidation remain outside this pilot.",
      "review_reference": "pilot-ci-review.json: discriminating execution evidence recorded; external maintainer acceptance remains pending.",
      "review_evidence": [
        "pilot-ci-review.json"
      ]
    }
  ],
